const ChangeDelete = diff.ChangeDelete
const ChangeEqual = diff.ChangeEqual
const ChangeInsert = diff.ChangeInsert
const Delete = diff.Delete
const Equal = diff.Equal
const Insert = diff.Insert
const Myers = algorithms.Myers
const Replace = diff.Replace
func (d *TextDiff) Algorithm() Algorithm
func (d *TextDiff) AllChanges() iter.Seq[Change]
func (d *TextDiff) AllRemappedChanges() iter.Seq[RemappedChange]
func (d *TextDiff) Changes(op DiffOp) iter.Seq[Change]
func (d *TextDiff) GroupedOps(n int) [][]DiffOp
func (d *TextDiff) NewLen() int
func (d *TextDiff) NewToken(i int) (string, bool)
func (d *TextDiff) NewTokens() iter.Seq[string]
func (d *TextDiff) NewlineTerminated() bool
func (d *TextDiff) OldLen() int
func (d *TextDiff) OldToken(i int) (string, bool)
func (d *TextDiff) OldTokens() iter.Seq[string]
func (d *TextDiff) Ops() []DiffOp
func (d *TextDiff) Ratio() float64
func (d *TextDiff) RemappedChanges(op DiffOp) []RemappedChange
func (d *TextDiff) SliceNew(start, end int) (string, bool)
func (d *TextDiff) SliceOld(start, end int) (string, bool)
func CaptureDiff[T comparable](alg Algorithm, old, new []T) []DiffOp
func DiffChars(old, new string, opts ...Option) *TextDiff
func DiffDeadline[T comparable](ctx context.Context, alg Algorithm, old, new []T) ([]DiffOp, error)
func DiffHookDeadline[T comparable](ctx context.Context, alg Algorithm, hook DiffHook, old, new []T) error
func DiffLines(old, new string, opts ...Option) *TextDiff
func DiffRangeHookDeadline[T comparable](ctx context.Context, alg Algorithm, hook DiffHook, old []T, oldStart, oldEnd int, new []T, newStart, newEnd int) error
func DiffRatio(ops []DiffOp, oldLen, newLen int) float64
func DiffSlices(old, new []string, opts ...Option) *TextDiff
func DiffText(old, new string, tok Tokenizer, opts ...Option) *TextDiff
func DiffWords(old, new string, opts ...Option) *TextDiff
func Diff[T comparable](old, new []T) []DiffOp
func GetCloseMatches(word string, possibilities []string, n int, cutoff float64) []string
func GroupDiffOps(ops []DiffOp, n int) [][]DiffOp
func NewCapture() *Capture
func NewReplaceHook(d DiffHook) *ReplaceHook
func WithAlgorithm(alg Algorithm) Option
func WithContext(ctx context.Context) Option
func WithNewlineTerminated(yes bool) Option
type Algorithm = algorithms.Algorithm
type Capture = diff.Capture
type Change = diff.Change
type ChangeTag = diff.ChangeTag
type DiffHook = diff.DiffHook
type DiffOp = diff.DiffOp
type DiffTag = diff.DiffTag
type NoopHook = diff.NoopHook
type Option func(*config)
type RemappedChange struct { Tag ChangeTag Value string }
type ReplaceHook = diff.ReplaceHook
type TextDiff struct { // contains filtered or unexported fields }
type Tokenizer interface { Split(s string) []string NewlineTerminated() bool }
var Chars Tokenizer = tokenizer{tokenizeChars, false}
var Lines Tokenizer = tokenizer{tokenizeLines, true}
var LinesAndNewlines Tokenizer = tokenizer{tokenizeLinesAndNewlines, false}
var Words Tokenizer = tokenizer{tokenizeWords, false}
