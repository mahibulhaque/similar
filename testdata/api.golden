type Algorithm int
type Capture struct { // contains filtered or unexported fields }
type Change struct { // contains filtered or unexported fields }
type ChangeTag int
type DiffHook interface { Equal(oldIndex, newIndex, length int) error Delete(oldIndex, oldLen, newIndex int) error Insert(oldIndex, newIndex, newLen int) error Replace(oldIndex, oldLen, newIndex, newLen int) error Finish() error }
type DiffOp struct { Tag DiffTag `json:"tag"` OldIndex int `json:"old_index"` NewIndex int `json:"new_index"` OldLen int `json:"old_len,omitempty"` NewLen int `json:"new_len,omitempty"` }
type DiffTag int
type NoopHook struct{}
type Option func(*config)
type RemappedChange struct { Tag ChangeTag Value string }
type ReplaceHook struct { // contains filtered or unexported fields }
type TextDiff struct { // contains filtered or unexported fields }
type Tokenizer interface { Split(s string) []string NewlineTerminated() bool }
var Chars Tokenizer = tokenizer{tokenizeChars, false}
var Lines Tokenizer = tokenizer{tokenizeLines, true}
var LinesAndNewlines Tokenizer = tokenizer{tokenizeLinesAndNewlines, false}
var Words Tokenizer = tokenizer{tokenizeWords, false}
